# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
# Optional overrides. Fast model for classification/matching, smart model for drafting/reports.
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_SMART=claude-sonnet-5

# --- Supabase (Project settings → API). Service role key is SERVER-ONLY. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio WhatsApp (sandbox or approved sender) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public URL Twilio calls, used for signature validation, e.g. https://awaaz.vercel.app/api/whatsapp
TWILIO_WEBHOOK_URL=
# Pre-approved WhatsApp templates (Content API SIDs) for messages sent >24h after the citizen's last message.
TWILIO_TEMPLATE_CHECKIN_SID=
TWILIO_TEMPLATE_REMINDER_SID=

# --- Embeddings for RAG (Voyage AI). Without a key, knowledge-base search is keyword-only and semantic duplicate matching is off. ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# --- Speech-to-text for voice notes (OpenAI Whisper API). Leave empty to ask citizens to type instead. ---
OPENAI_API_KEY=

# --- Email filing / Tier 2 CC via Resend (optional; without it filing is "assisted") ---
RESEND_API_KEY=
FILING_FROM_EMAIL=complaints@your-domain.pk

# --- App secrets ---
CITIZEN_HASH_SALT=change-me-long-random-string
CRON_SECRET=change-me
DASHBOARD_USER=authority
DASHBOARD_PASSWORD=change-me
PUBLIC_BASE_URL=https://awaaz.vercel.app
