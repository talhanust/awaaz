# Paste into Streamlit Cloud → your app → Settings → Secrets, with your own values.

# Required: Supabase → Connect → "Session pooler" connection string, with your database password filled in.
DATABASE_URL = "postgresql://postgres.YOURPROJECT:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# AI provider: add ONE of these keys. The app uses whichever is present.
#   Free: Google Gemini (aistudio.google.com → Get API key; no card needed). Recommended free option.
GEMINI_API_KEY = "your-gemini-key"
#   Free: Groq (console.groq.com). Open models; weaker in Urdu script; no photo reading.
# GROQ_API_KEY = ""
#   xAI Grok (console.x.ai). Key starts with "xai-".
# XAI_API_KEY = ""
#   Paid: Claude (console.anthropic.com).
# ANTHROPIC_API_KEY = "sk-ant-..."
# Without any key the app still runs, using labelled fallback rules.

# Required: password for department actions on the Authority dashboard (share it with judges).
DASHBOARD_PASSWORD = "choose-a-password"

# Required: any long random text; used to hash phone numbers.
CITIZEN_HASH_SALT = "replace-with-a-long-random-string"

# Optional: model names. Check the model list in your provider's console if a default stops working.
# LLM_MODEL = "gemini-2.5-flash"          # Gemini, Groq or Grok model
# CLAUDE_MODEL_FAST = "claude-haiku-4-5-20251001"
# CLAUDE_MODEL_SMART = "claude-sonnet-5"

# Optional extras
# VOYAGE_API_KEY = ""      # hybrid (meaning + keyword) RAG search; voyageai.com
# OPENAI_API_KEY = ""      # voice notes (Whisper)
# RESEND_API_KEY = ""      # email filing
# FILING_FROM_EMAIL = "complaints@your-domain.pk"
